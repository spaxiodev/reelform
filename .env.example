# ─────────────────────────────────────────────────────────────────────
# Reelform — environment template
#
#   cp .env.example .env.local
#
# Every var marked REQUIRED must be set or the app will refuse to boot
# (see lib/env.ts). NEXT_PUBLIC_* values are inlined into the browser
# bundle at build time — never put a secret behind that prefix.
# ─────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────
# REQUIRED. Public origin of the deployment, no trailing slash.
# Local: http://localhost:3000 · Production: https://www.reelform.io
# Used for Stripe redirect URLs, OAuth callbacks, sitemap and OG tags.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Search Console ───────────────────────────────────────────────────
# Optional. The token from Google Search Console's "HTML tag" ownership
# check (the content="..." value, not the whole <meta> tag). Set it in
# production only; leaving it blank simply omits the tag. Not needed at
# all if the property was verified by DNS TXT record instead.
GOOGLE_SITE_VERIFICATION=

# ── Supabase ─────────────────────────────────────────────────────────
# Project Settings → API. Run supabase/schema.sql, then every file in
# supabase/migrations/ in filename order.
# REQUIRED
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# REQUIRED — the anon/publishable key. Safe in the browser; RLS guards it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
# REQUIRED — bypasses RLS. Server-only. Rotate immediately if it ever leaks.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ── Admin ────────────────────────────────────────────────────────────
# Optional. Comma-separated Supabase user ids that get free, unmetered
# access (no credits spent). Find yours under Authentication → Users.
ADMIN_USER_IDS=

# ── Anthropic (Claude) ───────────────────────────────────────────────
# REQUIRED. Key from https://platform.claude.com — powers site generation,
# interactive edits and shot suggestions.
ANTHROPIC_API_KEY=sk-ant-...

# ── Higgsfield (video generation) ─────────────────────────────────────
# REQUIRED. Credentials from https://platform.higgsfield.ai are a key-id /
# key-secret pair. Set both, or paste the combined "id:secret" string into
# HIGGSFIELD_API_KEY on its own and leave the secret blank.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# Optional. Defaults to https://api.higgsfield.ai.
HIGGSFIELD_API_BASE=

# Optional. Which hosted text-to-video model to shoot with. One of:
#   seedance-pro-fast    (default — 720p/1080p, 5s/10s, all four ratios)
#   seedance-lite        (cheaper drafts, same options)
#   kling-2.5-turbo-pro  (no 21:9; the model picks its own resolution)
#   veo-3.1-fast         (16:9 and 9:16 only; 10s shots come back as 8s)
# Re-check lib/pricing.ts if you switch — the credit prices are tuned to the
# default model's cost.
HIGGSFIELD_MODEL=

# ── Stripe ───────────────────────────────────────────────────────────
# REQUIRED for checkout. Test keys (sk_test_...) are fine for development.
STRIPE_SECRET_KEY=sk_test_...

# REQUIRED for fulfilment. Signing secret of the webhook endpoint pointed at
# {NEXT_PUBLIC_APP_URL}/api/stripe/webhook, subscribed to:
#   checkout.session.completed, invoice.paid,
#   customer.subscription.updated, customer.subscription.deleted
# Locally: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Price ids created in the Stripe dashboard. Subscriptions bill monthly and
# grant credits that expire at each cycle; top-ups are one-time and never
# expire. Amounts must match lib/pricing.ts or the UI will lie about cost.
#
#   Starter   recurring monthly   $19   → 2,000 credits
STRIPE_PRICE_STARTER=price_...
#   Pro       recurring monthly   $49   → 6,000 credits
STRIPE_PRICE_PRO=price_...
#   Studio    recurring monthly   $129  → 18,000 credits
STRIPE_PRICE_STUDIO=price_...
#   Top-up    one-time            $10   → 900 credits
STRIPE_PRICE_TOPUP_SMALL=price_...
#   Top-up    one-time            $25   → 2,400 credits
STRIPE_PRICE_TOPUP_MEDIUM=price_...
#   Top-up    one-time            $60   → 6,200 credits
STRIPE_PRICE_TOPUP_LARGE=price_...

# ── Deploy integrations (Pro / Studio: push sites to the user's own stack) ──
# Sites are deployed into the *customer's* Vercel and Supabase accounts via
# OAuth, so these are our app credentials, not anyone's hosting keys.
# Without them the studio still offers the zip download; only "Publish live"
# is disabled.
#
# NOTE: the feature is currently switched off at the source, via DEPLOY_ENABLED
# in lib/pricing.ts. Setting these vars alone will not bring it back — flip that
# flag to true as well, and the plan perks, pricing copy, studio button and
# account tab all return together.

# REQUIRED before any account can be connected. 32+ random chars; it encrypts
# the stored OAuth tokens (lib/crypto.ts). Rotating it invalidates every
# existing connection — users simply reconnect.
#   openssl rand -base64 48
INTEGRATION_SECRET=

# Vercel integration (https://vercel.com/dashboard/integrations/console).
# Redirect URL: {NEXT_PUBLIC_APP_URL}/api/integrations/vercel/callback
# Scopes: read/write on Deployments, Projects and Environment Variables.
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
# The integration's URL slug — the last part of vercel.com/integrations/<slug>.
VERCEL_INTEGRATION_SLUG=

# Supabase OAuth app (Dashboard → Organization → OAuth Apps).
# Redirect URL: {NEXT_PUBLIC_APP_URL}/api/integrations/supabase/callback
# Used against the Management API to create projects, run the submissions-table
# migration and read project API keys.
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
